# Board facts of the Redmi Note 10 Pro (sweet) that are true of this phone and of no other SM7150.
# Read from ios-sweet's sources (touch, keys, display); the kernel still carries its own copies.
CONFIG_DEVICE="sweet"
CONFIG_PANEL_WIDTH=1080
CONFIG_PANEL_HEIGHT=2400
# Goodix GT9896 (Yellowstone protocol) at I2C address 0x5d on GENI SE7 (qup wrapper 1; TLMM 6/7 are SDA/SCL)
CONFIG_TOUCH_CHIP="goodix-gt9896"
CONFIG_TOUCH_I2C_ADDR=0x5d
CONFIG_TOUCH_SE_PA=0x00a84000
# its rail is switched through RPMh (L11C)
CONFIG_TOUCH_RAIL="L11C"
# power and volume keys on the PMIC over SPMI, polled
CONFIG_BUTTONS="spmi"
# the framebuffer the stock bootloader (ABL) leaves, and the MDP that scans it out
CONFIG_SPLASH_PA=0x9c000000
CONFIG_MDP_PA=0x0ae00000
